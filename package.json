{
  "name": "agy-switcher",
  "version": "0.1.0",
  "description": "macOS Antigravity profile switcher and Google Cloud Code Assist quota tracker for CLI and Paseo Desktop",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "bin": {
    "agy-switcher": "./bin/agy-switcher.mjs",
    "agys": "./bin/agy-switcher.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sync:plugin-core": "node scripts/sync-plugin-core.mjs",
    "sync:plugin-core:check": "node scripts/sync-plugin-core.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run sync:plugin-core:check && npm run typecheck && npm run check:bundle && npm test"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.16.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.12",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "typescript": "^5.8.0",
    "zod": "^4.6.5"
  }
}
